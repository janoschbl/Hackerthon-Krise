[Unit]
Description=Krise STT Backend, Avatar-Display und DFPlayer-Audio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/guenther/hackerthon-krise-laya
Environment=DISPLAY_ENABLED=1
Environment=AUDIO_ENABLED=1
ExecStart=/home/guenther/hackerthon-krise-laya/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
